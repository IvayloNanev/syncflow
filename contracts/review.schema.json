{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SyncFlow review v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "base_record_version": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "urn:syncflow:shared:1.0#/$defs/issue"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "enum": [
              "required:client_contact",
              "required:project",
              "required:artist",
              "required:track_title",
              "required:recording_version",
              "required:intended_use",
              "required:platforms",
              "required:territories",
              "required:campaign_term",
              "required:music_length",
              "required:budget",
              "required:response_deadline",
              "single_recording",
              "evidence_valid",
              "no_conflicting_scope",
              "deadline_unambiguous"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          }
        },
        "required": [
          "rule_id",
          "result"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "base_record_version",
    "issues",
    "checks"
  ],
  "additionalProperties": false
}
