{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SyncFlow follow_up v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "base_record_version": {
      "type": "integer",
      "minimum": 0
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "addressed_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "base_record_version",
    "subject",
    "body",
    "addressed_issue_ids"
  ],
  "additionalProperties": false
}
