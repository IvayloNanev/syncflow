{
  "name": "syncflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js lib/*.test.js",
    "test:durable": "vitest run --config vitest.durable.config.ts",
    "validate:fixtures": "node contracts/check-fixtures.js",
    "validate:evaluation": "node evaluation/check-corpus.js",
    "intake:demo": "node agents/intake/cli.js --provider mock --scenario incomplete",
    "intake:claude": "node agents/intake/cli.js --provider claude --scenario incomplete",
    "review:demo": "node agents/review/cli.js",
    "followup:demo": "node agents/follow-up/cli.js --provider mock",
    "followup:claude": "node agents/follow-up/cli.js --provider claude",
    "workflow:demo": "node agents/workflow/cli.js --provider mock --scenario incomplete",
    "workflow:claude": "node agents/workflow/cli.js --provider claude --scenario incomplete",
    "api:dev": "node server/start.js",
    "requests:demo": "node requests/demo.js",
    "requests:analysis:demo": "node requests/analysis-demo.js",
    "smoke": "node scripts/smoke.js",
    "data:reset": "node scripts/reset-dev-data.js"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "ajv": "8.18.0",
    "dotenv": "^18.0.9",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "workflow": "5.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workflow/vitest": "5.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  }
}
