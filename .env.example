# Copy this file to .env for local development. Do not commit .env or real credentials.
# Local prototype database. The SQLite file is ignored by Git.
DATABASE_URL="file:./dev.db"

# Local server/CLI credentials only. Never commit .env.
ANTHROPIC_API_KEY=
# Choose a model enabled for your Anthropic account.
ANTHROPIC_MODEL=claude-haiku-5-5
