# Copy this file to .env for local development. Do not commit .env or real credentials.
# Local prototype database. The SQLite file is ignored by Git.
DATABASE_URL="file:./dev.db"

# Local server/CLI credentials only. Never commit .env.
ANTHROPIC_API_KEY=
# Choose a model enabled for your Anthropic account.
ANTHROPIC_MODEL=claude-haiku-5-5

# Shared mode: all three values are required. Secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required for a hosted production deployment (for example https://syncflow.example).
SYNCFLOW_APP_ORIGIN=

# Optional server-only email forwarding (Resend Receiving)
RESEND_INBOUND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
SYNCFLOW_INBOUND_DOMAIN=
